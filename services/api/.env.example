# All defaults are local and require no API key.
INK_APP_ENV=development
INK_DATABASE_URL=sqlite:///./data/homeworker.db
INK_STORAGE_ROOT=./data/storage
INK_CORS_ORIGINS=http://localhost:3000
INK_MAX_UPLOAD_BYTES=26214400
INK_MAX_PDF_PAGES=100
INK_MAX_IMAGE_PIXELS=40000000
INK_MAX_EXTRACTED_CHARS_PER_PAGE=2000000
INK_OCR_DPI=200
INK_OCR_TIMEOUT_SECONDS=30
INK_OCR_LANGUAGES=eng
INK_LOW_CONFIDENCE_THRESHOLD=0.80

# Optional local-only classification refinement. `rules` performs no network calls.
ANALYZER_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=20
