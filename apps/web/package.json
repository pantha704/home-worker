{
  "name": "@homeworker/web",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "NEXT_PUBLIC_STATIC_EXPORT=1 next build && NEXT_PUBLIC_STATIC_EXPORT=1 node scripts/write-cloudflare-headers.mjs",
    "build:hosted": "NEXT_PUBLIC_RUNTIME_MODE=hosted next build && node scripts/write-cloudflare-headers.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@homeworker/contracts": "file:../../packages/contracts",
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.11",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.530",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "fake-indexeddb": "6.2.4",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
