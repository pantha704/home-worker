{
  "name": "@homeworker/web",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "vendor:tesseract": "node scripts/vendor-tesseract.mjs",
    "build": "next build",
    "build:pages": "node scripts/vendor-tesseract.mjs && NEXT_PUBLIC_STATIC_EXPORT=1 next build && NEXT_PUBLIC_STATIC_EXPORT=1 node scripts/write-cloudflare-headers.mjs",
    "build:hosted": "NEXT_PUBLIC_RUNTIME_MODE=hosted next build && node scripts/write-cloudflare-headers.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/vendor-tesseract.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/vendor-tesseract.mjs && playwright test"
  },
  "dependencies": {
    "@homeworker/contracts": "file:../../packages/contracts",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "6.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "6.2.7",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
