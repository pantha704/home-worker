{
  "name": "homeworker",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "context": "bash scripts/context-check.sh",
    "dev": "pnpm --filter @homeworker/web dev",
    "build": "pnpm --filter @homeworker/contracts test && pnpm --filter @homeworker/web build",
    "lint": "pnpm --filter @homeworker/web lint",
    "typecheck": "pnpm --filter @homeworker/web typecheck",
    "test": "pnpm --filter @homeworker/contracts test && pnpm --filter @homeworker/web test"
  }
}
