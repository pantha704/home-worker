{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homeworker.local/schemas/project.schema.json",
  "title": "Homeworker canonical project document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "filename",
    "mimeType",
    "sha256",
    "status",
    "revision",
    "createdAt",
    "updatedAt",
    "pages",
    "settings",
    "error"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "filename": { "type": "string", "minLength": 1 },
    "mimeType": { "enum": ["application/pdf", "image/png", "image/jpeg"] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["processing", "needs_review", "ready", "failed"] },
    "revision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    },
    "settings": { "$ref": "#/$defs/settings" },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      ]
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "enum": ["info", "warning", "error"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageNumber", "bbox", "extractor"],
      "properties": {
        "pageNumber": { "type": "integer", "minimum": 1 },
        "bbox": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bbox" }] },
        "extractor": { "enum": ["native_pdf", "tesseract", "manual"] }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "confidence", "reviewed", "source", "warnings"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["heading", "paragraph", "list_item", "equation", "table", "figure", "unknown"] },
        "text": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewed": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "widthPoints", "heightPoints", "blocks"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "widthPoints": { "type": "number", "exclusiveMinimum": 0 },
        "heightPoints": { "type": "number", "exclusiveMinimum": 0 },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personaId", "seed", "inkColor", "paperStyle", "marginMm", "lineSpacing"],
      "properties": {
        "personaId": { "enum": ["scholar", "casual", "compact"] },
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "inkColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "paperStyle": { "enum": ["plain", "ruled", "grid"] },
        "marginMm": { "type": "number", "minimum": 8, "maximum": 30 },
        "lineSpacing": { "type": "number", "minimum": 0.8, "maximum": 2.5 }
      }
    }
  }
}

