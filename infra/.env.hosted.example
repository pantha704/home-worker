# Server-only Render variables. Copy values into Render's environment UI; do not commit real values.
INK_APP_ENV=production
INK_RUNTIME_MODE=hosted
INK_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
INK_DATABASE_SCHEMA=homeworker
INK_STORAGE_PROVIDER=supabase
INK_PROCESSING_MODE=worker
INK_START_WORKER=true
INK_CORS_ORIGINS=https://YOUR_PROJECT.pages.dev
INK_WORK_ROOT=/tmp/homeworker

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=homeworker-private

# Hard free-tier application ceilings.
INK_MAX_UPLOAD_BYTES=10485760
INK_MAX_PDF_PAGES=30
INK_MAX_IMAGE_PIXELS=40000000
INK_MAX_EXTRACTED_CHARS_PER_PAGE=300000
INK_MAX_TOTAL_EXTRACTED_CHARS=1000000
INK_MAX_ARTIFACT_BYTES=20971520
INK_MAX_PROJECTS_PER_USER=20
INK_MAX_USER_STORAGE_BYTES=104857600
INK_MAX_PROJECT_REVISIONS=60
INK_UPLOAD_RATE_PER_HOUR=20
INK_MUTATION_RATE_PER_HOUR=240
INK_RETENTION_DAYS=14
INK_OCR_DPI=180
INK_OCR_TIMEOUT_SECONDS=30
INK_OCR_LANGUAGES=eng
ANALYZER_PROVIDER=rules
