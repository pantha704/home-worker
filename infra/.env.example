# Homeworker local Compose configuration. Copy to infra/.env and edit locally.
# No API key or paid service is required. Do not commit .env files.

INK_APP_ENV=production
INK_WEB_PORT=3000
INK_API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INK_CORS_ORIGINS=http://localhost:3000

# Persistent named volumes. Changing these selects a different data set.
INK_DATA_VOLUME=homeworker-data
OLLAMA_DATA_VOLUME=homeworker-ollama

# Conservative ingestion/OCR defaults.
INK_MAX_UPLOAD_BYTES=26214400
INK_MAX_PDF_PAGES=100
INK_MAX_IMAGE_PIXELS=40000000
INK_MAX_EXTRACTED_CHARS_PER_PAGE=2000000
INK_OCR_DPI=200
INK_OCR_TIMEOUT_SECONDS=30
INK_OCR_LANGUAGES=eng
INK_LOW_CONFIDENCE_THRESHOLD=0.80
# Deterministic rules are the free, zero-model core.
ANALYZER_PROVIDER=rules

# Optional local Ollama profile. It is disabled unless explicitly started.
# The image/model are free to run locally, but model download uses bandwidth and
# qwen3:4b is about 2.5 GB. Allow at least 6 GB container RAM for this profile.
OLLAMA_IMAGE=ollama/ollama:0.32.0
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Container resource ceilings. Raise deliberately for large local documents.
INK_API_CPUS=2.0
INK_API_MEMORY_LIMIT=4g
INK_API_MEMORY_RESERVATION=512m
INK_API_PIDS_LIMIT=256
INK_API_TMPFS_SIZE=1073741824
INK_WEB_CPUS=1.0
INK_WEB_MEMORY_LIMIT=1g
INK_WEB_MEMORY_RESERVATION=256m
INK_WEB_PIDS_LIMIT=128
OLLAMA_CPUS=4.0
OLLAMA_MEMORY_LIMIT=6g
OLLAMA_MEMORY_RESERVATION=2g
OLLAMA_PIDS_LIMIT=512

# Optional prebuilt image overrides. Defaults build locally from this checkout.
INK_API_IMAGE=homeworker-api:local
INK_WEB_IMAGE=homeworker-web:local
