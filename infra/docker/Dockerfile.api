# syntax=docker/dockerfile:1.14

FROM ghcr.io/astral-sh/uv:0.12.7 AS uv

FROM python:3.14.6-slim-bookworm AS builder

COPY --from=uv /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /build

COPY services/api/pyproject.toml services/api/uv.lock services/api/README.md ./
RUN --mount=type=cache,id=uv,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY services/api/app ./app
RUN --mount=type=cache,id=uv,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

FROM python:3.14.6-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH=/opt/venv/bin:${PATH}
ENV INK_APP_ENV=production
WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
       ca-certificates \
       tesseract-ocr \
       tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 ink \
    && useradd --system --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent ink \
    && mkdir -p /data/storage /app/assets/fonts \
    && chown -R 10001:10001 /data /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=10001:10001 /build/app /app/app
COPY --chown=10001:10001 assets/fonts /app/assets/fonts

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).read()"]

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips="]
